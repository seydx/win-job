{
  "name": "@seydx/win-job",
  "version": "0.1.0",
  "description": "Windows job objects for Node.js: keep a process tree together and kill it with its parent",
  "author": "seydx (https://github.com/seydx/win-job)",
  "main": "index.js",
  "types": "index.d.ts",
  "type": "commonjs",
  "napi": {
    "binaryName": "win-job",
    "targets": [
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "audit": "npm audit fix",
    "artifacts": "napi artifacts",
    "build:debug": "napi build --platform --js binding.js --dts binding.d.ts",
    "build": "napi build --platform --release --js binding.js --dts binding.d.ts",
    "clean:cargo": "cargo clean",
    "clean": "cargo clean && rimraf --glob *.node",
    "format": "prettier --write 'src/' '__test__/' --ignore-unknown --no-error-on-unmatched-pattern && cargo fmt",
    "install-updates": "npm i --save",
    "lint": "cargo clippy --fix --allow-dirty --target x86_64-pc-windows-msvc && eslint --fix .",
    "prepublishOnly": "napi prepublish --no-gh-release",
    "release": "bash scripts/release.sh",
    "test": "node --test __test__/*.test.mjs",
    "update": "updates -M npm,pypi,go,cargo,docker,make --update ./",
    "version": "napi version"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.8",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "9.39.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.2",
    "updates": "^19.2.0"
  },
  "bugs": {
    "url": "https://github.com/seydx/win-job/issues"
  },
  "homepage": "https://github.com/seydx/win-job#readme",
  "keywords": [
    "windows",
    "job-object",
    "process-tree",
    "child-process",
    "kill",
    "rust"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seydx/win-job.git"
  },
  "engines": {
    "node": ">= 20"
  }
}
